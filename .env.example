# Traefik local development configuration
# Copy to .env (make check-env does it) and adjust.

# Local domain. Use a reserved TLD that never resolves publicly:
# .test (recommended) or .internal. Avoid .local (mDNS) and real TLDs.
# Services get <name>.${DOMAIN}; the certificate covers ${DOMAIN} and *.${DOMAIN}.
DOMAIN=freyr.test

# Extra names for the certificate, space-separated (optional),
# e.g. "localhost 127.0.0.1" or "*.api.freyr.test".
CERT_EXTRA_NAMES=

# Directory with local.crt, local.key and rootCA.pem (made by make certs)
SSL_DIR=./ssl

# Host address for ports 80/443. 127.0.0.1 keeps the proxy off the LAN;
# set 0.0.0.0 to reach it from other devices.
BIND_IP=127.0.0.1

# Host port of the dnsmasq container (127.0.0.1 only)
DNS_PORT=53

# Traefik
TRAEFIK_IMAGE=traefik:v3.7
TRAEFIK_DASHBOARD_SUBDOMAIN=traefik
TRAEFIK_LOG_LEVEL=INFO
PROXY_CONTAINER=traefik
